{
	"name": "@shadowbox/secure-agent-api",
	"version": "1.0.0",
	"type": "module",
	"private": true,
	"description": "A minimal example of using the Sandbox SDK",
	"scripts": {
		"deploy": "wrangler deploy",
		"predeploy:production": "corepack pnpm --dir ../.. gate:secure-container-image",
		"deploy:production": "wrangler deploy --config wrangler.production.jsonc",
		"dev": "wrangler dev --port 8787 --inspector-port 9229",
		"start": "wrangler dev",
		"cf-typegen": "wrangler types",
		"check-types": "tsc --noEmit",
		"test": "node --test test/**/*.test.js && vitest run --dir src"
	},
	"devDependencies": {
		"@cloudflare/sandbox": "^0.12.3",
		"@cloudflare/workers-types": "^4.20260702.1",
		"@repo/typescript-config": "workspace:*",
		"@types/node": "^24.10.9",
		"typescript": "^5.9.3",
		"vitest": "^1.0.0",
		"wrangler": "^4.61.0",
		"ws": "^8.19.0"
	},
	"dependencies": {
		"@repo/git-service": "workspace:*",
		"@repo/observability": "workspace:*",
		"@repo/shared-types": "workspace:*",
		"zod": "^3.25.1"
	},
	"author": "",
	"license": "MIT"
}
