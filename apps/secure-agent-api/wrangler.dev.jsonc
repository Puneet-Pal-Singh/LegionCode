{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "legioncode-api-dev",
  "main": "src/index.ts",
  "compatibility_date": "2025-05-06",
  "compatibility_flags": ["nodejs_compat"],
  "limits": {
    "cpu_ms": 60000,
  },
  "routes": [
    {
      "pattern": "api-dev.legioncode.dev",
      "custom_domain": true,
    },
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1,
  },
  "containers": [
    {
      "name": "legioncode-api-sandbox-dev",
      "class_name": "Sandbox",
      "image": "./Dockerfile",
      "instance_type": "lite",
      "max_instances": 3,
    },
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "AGENT_RUNTIME",
        "class_name": "AgentRuntime",
      },
      {
        "name": "Sandbox",
        "class_name": "Sandbox",
      },
      {
        "name": "LAUNCH_RATE_LIMITER",
        "class_name": "LaunchRateLimiter",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v3",
      "new_sqlite_classes": ["AgentRuntime", "Sandbox"],
    },
    {
      "tag": "v4-launch-rate-limiter",
      "new_sqlite_classes": ["LaunchRateLimiter"],
    },
  ],
  "r2_buckets": [
    {
      "binding": "ARTIFACTS",
      "bucket_name": "legioncode-artifacts-dev",
      "remote": true,
    },
  ],
  "services": [
    {
      "binding": "BRAIN",
      "service": "legioncode-brain-dev",
    },
  ],
  "vars": {
    "ENVIRONMENT": "development",
    "CORS_ALLOWED_ORIGINS": "https://legioncode-web-dev.pages.dev",
    "CORS_ALLOW_DEV_ORIGINS": "false",
    "LAUNCH_EMERGENCY_SHUTOFF_MODE": "off",
    "LAUNCH_RATE_LIMIT_REQUIRED": "true",
  },
}
