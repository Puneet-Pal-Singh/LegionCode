{
  "name": "@legioncode/brain",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node ./scripts/dev-with-secure-runtime.mjs",
    "deploy": "pnpm run deploy:production",
    "deploy:dev": "node ../../scripts/gates/check-cloudflare-dev-isolation.mjs && wrangler deploy --config wrangler.dev.jsonc",
    "deploy:production": "wrangler deploy --config wrangler.production.jsonc",
    "check-types": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240208.0",
    "@repo/shared-types": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/node": "^20.0.0",
    "eslint": "^9.39.1",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.46.4",
    "vitest": "^1.0.0",
    "wrangler": "^4.61.0"
  },
  "dependencies": {
    "@legioncode/app-server": "workspace:*",
    "@ai-sdk/anthropic": "1.1.0",
    "@ai-sdk/google": "1.1.0",
    "@ai-sdk/openai": "^1.1.0",
    "@repo/event-store": "workspace:*",
    "@repo/hook-protocol": "workspace:*",
    "@repo/observability": "workspace:*",
    "@repo/platform-protocol": "workspace:*",
    "@repo/runtime-kernel": "workspace:*",
    "@repo/provider-core": "workspace:*",
    "@legioncode/context-pruner": "workspace:*",
    "@legioncode/execution-engine": "workspace:*",
    "@legioncode/orchestrator-core": "workspace:*",
    "@legioncode/github-bridge": "workspace:*",
    "@repo/persistence": "workspace:*",
    "ai": "4.1.0",
    "zod": "^3.22.4",
    "zod-to-json-schema": "3.25.1"
  }
}
