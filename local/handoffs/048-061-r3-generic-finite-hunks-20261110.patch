+/** Private Node dispatch uses saved ownership, never the current harness picker.
+ * The canonical Native service is supplied by its trusted composition owner.
+ */
+function createLocalSavedOwnerRouting(
+  delegated: LocalHarnessComposition["turnService"],
+  native?: NonNullable<AppServerComposition["localTurnService"]>,
+): NonNullable<AppServerComposition["localTurnService"]> {
+  const requireNative = () => {
+    if (!native) throw new AppServerOperationError(503, "server_unavailable", "Native local execution is not configured", undefined, false);
+    return native;
+  };
+  const saved = async (turnId: Parameters<typeof delegated.savedTurnBackend>[0]) =>
+    (await delegated.savedTurnBackend(turnId)) === "delegated" ? delegated : requireNative();
+  return {
+    // turn/start has no delegated captured selection; omission belongs to Native.
+    startTurn: (params) => requireNative().startTurn(params),
+    getTurn: async (turnId) => (await saved(turnId)).getTurn(turnId),
+    readHistory: (params) => (native ?? delegated).readHistory(params),
+    interruptTurn: async (params) => (await saved(params.turnId)).interruptTurn(params),
+    submitLifecycleApproval: async (params) => (await saved(params.turnId)).submitLifecycleApproval(params),
+    submitUserInputResponse: async (params) => {
+      const owner = await saved(params.turnId);
+      if (!owner.submitUserInputResponse) throw new AppServerOperationError(503, "server_unavailable", "Local question responses are unavailable", undefined, false);
+      return owner.submitUserInputResponse(params);
+    },
+  };
 }
 
