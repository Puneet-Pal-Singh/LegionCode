+import { createStableEventFingerprint } from "@repo/event-store";
+import { HarnessAccountSetupPrincipalSchema, HarnessAccountSetupLeaseSchema,
+  HarnessAccountSetupReceiptSchema, type HarnessAccountSetupPrincipal,
+  type HarnessAccountSetupLease } from "@repo/worker-protocol";
+import type { Env } from "../types/ai";
+
+export function createHostedAccountSetupClient(env: Env, signal: AbortSignal) {
+  const call = async (body: object) => {
+    signal.throwIfAborted();
+    const secret = env.INTERNAL_RUNTIME_EVENT_SECRET;
+    if (!secret) throw new Error("Account setup service authentication unavailable");
+    const response = await env.SECURE_API.fetch("http://internal/api/v1/internal/harness/account-setup", {
+      method: "POST", signal, headers: { "Content-Type": "application/json",
+        "X-Internal-Runtime-Secret": secret }, body: JSON.stringify(body) });
+    if (!response.ok) throw new Error("Account setup unavailable; recovery required");
+    return response.json(); // bounded response handling MUST reuse existing service limit helper
+  };
+  return {
+    async prepare(input: Omit<HarnessAccountSetupPrincipal, "commandFingerprint">) {
+      const principal = HarnessAccountSetupPrincipalSchema.parse({ ...input,
+        commandFingerprint: createStableEventFingerprint(input) });
+      const lease = HarnessAccountSetupLeaseSchema.parse(await call({operation:"account_setup_prepare",principal}));
+      if (JSON.stringify(lease.principal) !== JSON.stringify(principal))
+        throw new Error("Account setup lease binding mismatch");
+      return lease;
+    },
+    async authenticate(lease: HarnessAccountSetupLease, material: {type:"api_key";apiKey:string}) {
+      const receipt = HarnessAccountSetupReceiptSchema.parse(await call({operation:"account_setup_authenticate",lease,material}));
+      if (JSON.stringify(receipt.lease) !== JSON.stringify(lease))
+        throw new Error("Account setup receipt binding mismatch");
+      return receipt;
+    },
+    async close(lease: HarnessAccountSetupLease) {
+      await call({operation:"account_setup_close",lease});
+      // Not physical closure proof. Durable owner retains ambiguous descendants.
+    },
+    async inspect(lease: HarnessAccountSetupLease) {
+      return HarnessAccountSetupReceiptSchema.parse(await call({operation:"account_setup_inspect",lease}));
+    },
+  };
+}
