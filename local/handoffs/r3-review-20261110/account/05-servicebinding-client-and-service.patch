+/** ROOT/HOST PROPOSED CONTRACT: implemented by EXISTING AgentRuntime physical
+ * lease owner + root resident bootstrap; not by a browser/config boolean.
+ * Existing turn lease/session methods MUST NOT be used with fake identities. */
+export interface CloudAccountSetupAuthority {
+  assertSetupOwner(principal: HarnessAccountSetupPrincipal): Promise<void>;
+  assertEnforced(): Promise<void>;
+  // Hydrates exact selected pinned runtime BEFORE import/UID drop; allocates a
+  // real process generation and persists its lease through existing owner.
+  prepareRootSetup(principal: HarnessAccountSetupPrincipal): Promise<HarnessAccountSetupLease>;
+  assertLease(lease: HarnessAccountSetupLease, phase: "authenticate" | "inspect" | "close"): Promise<void>;
+  authenticatePrivate(lease: HarnessAccountSetupLease, material: {type:"api_key";apiKey:string}): Promise<HarnessAccountSetupReceipt>;
+  inspectPrivate(lease: HarnessAccountSetupLease): Promise<HarnessAccountSetupReceipt>;
+  closePrivate(lease: HarnessAccountSetupLease): Promise<void>;
+}
+/** Caller is index.ts AFTER enforceInternalServiceBinding. Body is bounded by
+ * readBody; errors are fixed and never echo credentials/native HTTP payloads. */
+export async function handleCloudHarnessAccountSetup(request: Request, authority: CloudAccountSetupAuthority): Promise<Response> {
+  try {
+    const operation = HarnessAccountSetupRequestSchema.parse(await readBody(request));
+    if (operation.operation === "account_setup_prepare") {
+      await authority.assertSetupOwner(operation.principal);
+      await authority.assertEnforced();
+      const lease = HarnessAccountSetupLeaseSchema.parse(await authority.prepareRootSetup(operation.principal));
+      await authority.assertLease(lease, "inspect");
+      return Response.json(lease);
+    }
+    const phase = operation.operation === "account_setup_authenticate" ? "authenticate"
+      : operation.operation === "account_setup_inspect" ? "inspect" : "close";
+    await authority.assertLease(operation.lease, phase);
+    if (phase === "close") {
+      // Cleanup validates physical lease only, including revoked credentials.
+      // It cannot hydrate a runtime or start a replacement generation.
+      await authority.closePrivate(operation.lease);
+      return Response.json({closed:true}); // no physical-closure proof inferred
+    }
+    await authority.assertSetupOwner(operation.lease.principal);
+    await authority.assertEnforced();
+    const receipt = HarnessAccountSetupReceiptSchema.parse(
+      operation.operation === "account_setup_authenticate"
+        ? await authority.authenticatePrivate(operation.lease, operation.material)
+        : await authority.inspectPrivate(operation.lease));
+    await authority.assertLease(operation.lease, phase);
+    return Response.json(receipt);
+  } catch {
+    return Response.json({code:"unavailable"}, {status:503});
+  }
+}
