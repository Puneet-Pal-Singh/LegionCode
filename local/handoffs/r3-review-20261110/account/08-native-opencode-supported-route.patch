+/** Proposed exact pinned redacted route. Host provenance gate is mandatory:
+ * reviewed source76ff9a6 has not been cryptographically mapped to CLI2.2.5. */
+export async function establishOpenCodeApiKeySetup(client: OpenCodeClient,
+  integrationID: string, key: string, setupCommandId: string): Promise<string> {
+  const before = await client.inspect("integration.get", (api,signal) =>
+    api.integration.get({integrationID},{signal}));
+  const ids = new Set(before.data.connections.filter(c=>c.type==="credential").map(c=>c.id));
+  await client.connectKeyForSetup(integrationID,key,setupCommandId);
+  const after = await client.inspect("integration.get", (api,signal) =>
+    api.integration.get({integrationID},{signal}));
+  const selected = after.data.connections[0];
+  const added = after.data.connections.filter(c=>c.type==="credential" && !ids.has(c.id));
+  if (added.length !== 1 || !selected || selected.type !== "credential" ||
+      selected.method !== "key" || selected.label !== setupCommandId ||
+      ids.has(selected.id) || selected.status?.status === "needs_auth")
+    throw new Error("OpenCode selected native credential unavailable");
+  return selected.id; // actual native ID, never provider-account identity
+}
+export async function verifyOpenCodeApiKeySetup(client: OpenCodeClient,
+  integrationID: string, nativeCredentialId: string): Promise<void> {
+  const result = await client.inspect("integration.get", (api,signal) =>
+    api.integration.get({integrationID},{signal}));
+  const c = result.data.connections[0];
+  if (!c || c.type !== "credential" || c.id !== nativeCredentialId || c.method !== "key" ||
+      c.status?.status === "needs_auth") throw new Error("OpenCode selected credential changed");
+}
