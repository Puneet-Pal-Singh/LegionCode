+  /** Explicit authenticated setup only: after server.info, before sessions or
+   * native prompts. No retry following a lost outcome. Secret never returned. */
+  async connectKeyForSetup(integrationID: string, key: string, label: string): Promise<void> {
+    if (!this.verified || this.state !== "new" || this.setupKeySubmitted)
+      throw new OpenCodeTransportError("account setup", true);
+    this.setupKeySubmitted = true;
+    try {
+      await this.native.integration.connect.key({integrationID,key,label},
+        {signal: AbortSignal.timeout(10000)});
+    } catch {
+      this.fail();
+      throw new OpenCodeTransportError("account setup", true);
+    }
+  }
